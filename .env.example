# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.
# NEVER commit real values.

# --- Database (any Postgres: Neon, Vercel Postgres/Marketplace, Supabase, ...) ---
# Use the pooled connection string, with ?sslmode=require for hosted databases.
# Vercel's Postgres/Neon integration sets DATABASE_URL (and POSTGRES_URL) for you.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Admin login (generate both lines with: npm run hash-password) ---
# scrypt hash of the admin password (never store the password itself)
ADMIN_PASSWORD_HASH=
# random string, at least 32 characters, used to sign the login cookie
SESSION_SECRET=
